generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  CLIENTE
  MAYORISTA
  ADMIN
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

/// Every review lands on PENDING and is invisible to shoppers until an admin
/// approves it. Brisal has no general customer login — only wholesale accounts —
/// so moderation, not authentication, is the spam gate.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Models ─────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  /// Single point, not a desktop/mobile pair: a given row renders in
  /// exactly ONE display shape -- the homepage band (rectangle) if this is
  /// a top-level category, or the subcategory circle if not -- and neither
  /// shape varies by viewport, so one point covers it.
  imagePosX   Int        @default(50)
  imagePosY   Int        @default(50)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  discounts   Discount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

/// A catalog material — "Acero", "Rodio", "Oro laminado".
///
/// Many-to-many because a single piece is routinely more than one thing (an
/// steel body with a rhodium finish), which the legacy free-text
/// `Product.material` column could never express: it forced one string and let
/// the same material be spelled four different ways. That column is kept for
/// now so this migration stays additive; the relation below is the source of
/// truth and the free text is no longer written by the admin form.
///
/// Modelled on Tag: an implicit relation table, no explicit join model, since
/// nothing needs to hang extra fields off the pairing.
model Material {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[] @relation("ProductMaterials")
  createdAt DateTime  @default(now())
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  price            Decimal        @db.Decimal(10, 2)
  comparePrice     Decimal?       @db.Decimal(10, 2)
  wholesalePrice   Decimal?       @db.Decimal(10, 2)
  sku              String?        @unique
  stock            Int            @default(0)
  /// LEGACY free-text material. Superseded by the `materials` relation below and
  /// no longer written by the admin form; retained so this change stays purely
  /// additive and the original strings survive the backfill. Safe to drop once
  /// the client confirms the migrated values look right.
  material         String?
  materials        Material[]     @relation("ProductMaterials")
  /// The PRIMARY colour, which belongs to the product itself — its own
  /// imageUrls, price, stock and sku ARE that colour's. ColorVariant rows are
  /// ADDITIONAL colours on top of it, so a single-colour product needs no
  /// variant and enters its stock only once.
  colorName        String?
  colorHex         String?
  imageUrls        String[]
  featured         Boolean        @default(false)
  active           Boolean        @default(true)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  tags             ProductTag[]
  /// Back-relation of the LEGACY `Discount.productId`. Nothing reads it — see
  /// `appliedDiscounts`, which is the many-to-many that replaced it.
  discounts        Discount[]
  /// PRODUCT-scoped discounts applying to this product, via the join table.
  appliedDiscounts Discount[]     @relation("DiscountProducts")
  // A product with NO colorVariants is a simple product and keeps using
  // `imageUrls`, `price` and `stock` above exactly as before.
  colorVariants    ColorVariant[]
  reviews          Review[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  /// Trigram index backing the typo-tolerant search.
  ///
  /// DECLARED HERE ON PURPOSE. It was first created by
  /// prisma/sql/2026-08-21-search-trigram.sql, and `migrate diff` then reported
  /// `DROP INDEX "Product_name_trgm_idx"` — Prisma prunes indexes the schema
  /// does not mention, so the very next `db push` would have silently deleted
  /// it and quietly turned every search back into a sequential scan. Declaring
  /// it makes the diff additive and keeps the index alive across pushes.
  ///
  /// Requires the pg_trgm extension (see that SQL file). It serves both the
  /// similarity operators and the pre-existing `ILIKE '%…%'` substring scans.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

/// A shopper-submitted review. Anyone can write one without an account, which
/// is why `status` exists — nothing reaches the storefront unread.
model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Display name the shopper typed. Not a User link: reviewers are anonymous.
  authorName String
  /// 1-5. Validated at the API edge; there is no CHECK constraint because the
  /// only writer is the route, which clamps before it ever reaches Postgres.
  rating     Int
  title      String?
  body       String?
  /// Up to 4 customer photos, already processed to WebP and uploaded.
  imageUrls  String[]
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  /// The storefront always asks for one product's APPROVED reviews, and the
  /// rating aggregate groups by the same pair — so they share an index.
  @@index([productId, status])
  /// The moderation queue reads newest-first within a status.
  @@index([status, createdAt])
}

/// One colour of a product: its own images, its own stock, and optional
/// price overrides. A null `price`/`wholesalePrice` means "inherit the
/// product-level value" rather than "free" — see resolveVariantPricing.
model ColorVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName      String
  /// Hex for the swatch, shown in both the catalog filter and the selector.
  colorHex       String
  imageUrls      String[]
  price          Decimal? @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Discount {
  id         String        @id @default(cuid())
  code       String?       @unique
  label      String
  percentage Decimal       @db.Decimal(5, 2)
  scope      DiscountScope
  /// LEGACY single-product link, superseded by `products` below. One row could
  /// only ever discount ONE product, so a 23-product promo meant 23 rows all
  /// named the same thing — unreadable in the admin list and impossible to
  /// renew as a unit. Kept so this migration stays additive; backfilled into
  /// `products` and no longer read. Safe to drop once confirmed.
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id])
  /// The products a PRODUCT-scoped discount applies to. One campaign, many
  /// products — this is what every read uses now.
  products   Product[]     @relation("DiscountProducts")
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean       @default(true)
  /// Who the campaign is for: "ALL" | "WHOLESALE_ONLY" | "RETAIL_ONLY".
  ///
  /// A plain String with a default rather than an enum, so this is a pure
  /// column add — no CREATE TYPE, and every existing row reads as "ALL", which
  /// is exactly how discounts behaved before the column existed. The three
  /// legal values are enforced at both boundaries by `discountAudienceSchema`
  /// in src/lib/validators, and normalised on read by `toDiscountAudience` in
  /// src/lib/repositories/mappers.ts, which falls back to "ALL" for anything
  /// unrecognised rather than silently dropping the discount.
  ///
  /// WHOLESALE_ONLY is the one case that composes with a wholesale price. See
  /// the note in src/lib/utils/pricing.ts: ALL-audience promos still never
  /// stack on a negotiated wholesale rate, but a discount authored
  /// specifically FOR wholesalers is an explicit instruction to give them one.
  audience    String       @default("ALL")
  /// Units required before this discount applies. NULL = no quantity
  /// requirement at all, which is the default and what every pre-existing
  /// discount has — those keep applying at any quantity, unchanged.
  ///
  /// Counted across every cart line the discount reaches, not per line: two
  /// colours of the same product are 5 units of that product to a shopper, and
  /// a CATEGORY-scoped rule aggregates over the whole category. See
  /// `qualifyingQuantities` in src/lib/pricing/quote.ts.
  minQuantity Int?
  createdAt  DateTime      @default(now())
}

/// A manually-entered checkout code, deliberately SEPARATE from `Discount`.
///
/// `Discount` is automatic and scoped to products/categories; a coupon is
/// typed by the shopper and applies one flat percentage to the whole cart
/// subtotal. Merging the two would have meant every Discount row growing
/// usage-limit and redemption bookkeeping it has no use for.
///
/// RLS on this table has NO public SELECT policy on purpose: a readable
/// coupons table lets anyone enumerate every valid code. Validation goes
/// through a server route that checks the code as the table owner.
model Coupon {
  id         String    @id @default(cuid())
  /// Stored UPPERCASE and matched case-insensitively, so "brisal10" and
  /// "BRISAL10" are the same coupon rather than two.
  code       String    @unique
  percentage Decimal   @db.Decimal(5, 2)
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// null = unlimited redemptions.
  usageLimit Int?
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model User {
  id                     String    @id @default(cuid())
  authId                 String    @unique
  email                  String    @unique
  name                   String?
  role                   Role      @default(CLIENTE)
  businessName           String?
  taxId                  String?
  city                   String?
  phone                  String?
  approved               Boolean   @default(true) // set to false explicitly when a wholesale signup is pending review; not used for CLIENTE
  /// Set when an admin rejects a pending wholesale application. Previously a
  /// rejection hard-deleted the User immediately -- with no confirmation and
  /// no check for attached data -- which also meant the admin's "Rechazadas"
  /// tab was a client-side-only illusion that vanished on refresh, and
  /// "Volver a Pendientes" on it 404'd because the row was already gone.
  /// Null means never rejected (or since un-rejected/re-approved -- both
  /// clear it). Distinct from `approved`, which stays false while rejected,
  /// so PENDIENTE and RECHAZADO can both be told apart from one boolean plus
  /// this timestamp.
  rejectedAt             DateTime?
  /// Set when an admin revokes an ALREADY-APPROVED wholesaler's access.
  ///
  /// Deliberately its own field rather than reusing `rejectedAt`: the two are
  /// different events about different people. A rejection is an application
  /// that was never granted and never transacted — which is why the DELETE
  /// handler is scoped to it. A revocation is a formerly active account that
  /// very likely HAS order history, and must never become deletable by
  /// inheriting the rejected path's copy and actions.
  ///
  /// Revoking sets `approved = false` alongside this, which is the single flag
  /// `getSessionResult` reads — so wholesale pricing stops on the account's
  /// very next price check, with no stale-session window. Re-approval clears
  /// this (and `rejectedAt`) and flips `approved` back to true, so reinstating
  /// someone is a status change, not a re-registration.
  revokedAt              DateTime?
  /// Null until shown once. Gates the in-app wholesale welcome message on
  /// first login after approval -- see `SiteConfig.wholesaleWelcomeMessage`.
  /// Reset to null on every transition INTO approved, so a wholesaler who is
  /// reapproved after being reverted to pending or rejected sees it again.
  wholesaleWelcomeSeenAt DateTime?
  lastOrderAt            DateTime?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Order {
  id                   String      @id @default(cuid())
  items                OrderItem[]
  total                Decimal     @db.Decimal(10, 2)
  status               OrderStatus @default(PENDING_WHATSAPP)
  customerName         String?
  customerPhone        String?
  wholesaleUserId      String?
  /// The coupon code as typed at checkout, and the peso amount it took off.
  /// Stored as a snapshot rather than a relation: the coupon may later be
  /// edited or deleted, and what the customer was actually charged must not
  /// change with it.
  couponCode           String?
  couponDiscountAmount Decimal?    @db.Decimal(10, 2)
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

enum OrderStatus {
  PENDING_WHATSAPP
  CONFIRMED
  REJECTED
  CANCELLED
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  name           String
  price          Decimal @db.Decimal(10, 2)
  quantity       Int
  imageUrl       String?
  /// Which colour was ordered. Null for simple products with no variants,
  /// so existing order history stays valid.
  color          String?
  /// The ColorVariant this line was ordered in, or null when the line is the
  /// product's PRIMARY colour (or the product has no colours at all). Stock
  /// lives per colour, so confirming an order can only decrement the right
  /// row if it knows which one it was. Deliberately NOT a relation: deleting a
  /// variant must not cascade into — or be blocked by — order history, which
  /// keeps its own `color` and `reference` snapshot regardless.
  colorVariantId String?
  /// The reference as it stood WHEN ORDERED. Stored rather than derived so a
  /// later SKU change can't rewrite what an old order says was shipped.
  reference      String?
  /// How many of `quantity` were beyond the colour's available stock at order
  /// time — 0 when the line was fully in stock. This is the record of what the
  /// client still owes the customer ("sobrepedido"), and it is never rewritten
  /// when stock is later replenished: it says what was true when ordered.
  backorderQty   Int     @default(0)
}

model SiteConfig {
  id                      String  @id @default("singleton")
  announcementText        String  @default("Envíos gratis en compras superiores a $200.000")
  announcementActive      Boolean @default(true)
  /// Parallax backdrops for the two homepage bands that scroll their
  /// background against their content: BrandStatement ("Cada pieza, una
  /// historia.") and WholesaleCallout ("¿Tienes un negocio?").
  ///
  /// Named after the components rather than the copy so a future wording
  /// change doesn't strand the column. Nullable on purpose — null means "no
  /// backdrop", and each section falls back to the flat gradient treatment it
  /// shipped with, which is a valid finished look rather than a broken one.
  /// DEPRECATED. The brand-statement band is video+text now and reads no
  /// image at all — the admin control was removed with it. Kept rather than
  /// dropped, matching the convention `Product.material` and
  /// `Discount.productId` set: the column holds a real URL the client
  /// uploaded, and dropping it is the one change that cannot be undone if the
  /// section ever wants a still again. Nothing reads it.
  brandStatementImageUrl  String?
  wholesaleImageUrl       String?
  /// The video+text band that replaced the flat "Cada pieza, una historia."
  /// statement. Named after the SECTION rather than the copy, matching the
  /// convention above, so rewording it doesn't strand the columns.
  ///
  /// All three nullable and independent: the section falls back to its
  /// original centred statement when the title/body are unset, and to a still
  /// frame treatment when only the video is missing. A half-configured section
  /// is a valid state, not a broken one.
  videoSectionTitle       String?
  videoSectionBody        String?
  videoSectionVideoUrl    String?
  /// Single point, not a desktop/mobile pair: the section renders at a
  /// constant `aspect-square` regardless of viewport width, so there is
  /// only one frame shape to crop for.
  videoSectionPosX        Int     @default(50)
  videoSectionPosY        Int     @default(50)
  /// Where the band links to — any internal path the admin types, e.g.
  /// "/catalogo/aretes" or "/catalogo?tag=nuevo". Null means the section is
  /// not clickable at all, which is the state it shipped in.
  videoSectionLinkUrl     String?
  /// ── Wholesale band background ──────────────────────────────────────
  /// Which media the band actually renders: "NONE" | "VIDEO" | "IMAGE".
  ///
  /// Before this existed, `wholesaleVideoUrl` and `wholesaleImageUrl` could
  /// both be set from two different admin panels, with video silently winning
  /// and no way to fall back to the image short of deleting the video. The
  /// type is now the single source of truth, so toggling to "NONE" or back
  /// never destroys an uploaded asset — it just stops pointing at it.
  ///
  /// A String rather than an enum: three values on a singleton row, and the
  /// admin writes it from a plain select. Parsed at the edge.
  wholesaleBgType         String  @default("NONE")
  /// Focal points as whole percentages (0-100), stored per breakpoint for the
  /// same reason HeroSlide does: a 16:9 desktop band and a tall phone band
  /// almost never keep the same part of a picture. 50/50 is what
  /// `object-cover` does unaided, so an unset background is unchanged.
  wholesaleBgPosX         Int     @default(50)
  wholesaleBgPosY         Int     @default(50)
  wholesaleBgPosXMobile   Int     @default(50)
  wholesaleBgPosYMobile   Int     @default(50)
  /// Optional phone-specific assets. Null means "use the desktop file with
  /// the MOBILE focal point", exactly as the hero falls back.
  wholesaleVideoUrlMobile String?
  wholesaleImageUrlMobile String?
  /// Desktop/primary assets for their respective types. Names kept as-is so
  /// nothing already uploaded is stranded.
  wholesaleVideoUrl       String?

  /// ── Legal pages ────────────────────────────────────────────────────
  /// Long-form body text for /legal/terminos and /legal/privacidad, in the
  /// small markdown subset `parseLegalText` understands (## headings, blank
  /// -line-separated paragraphs, `- ` bullets).
  ///
  /// The copy used to be JSX inside each page, so changing a clause meant a
  /// code change and a deploy — which is the wrong shape for a document the
  /// client's lawyer will want to revise. Null renders the "en preparación"
  /// state rather than an empty page.
  termsAndConditionsText String?
  privacyPolicyText      String?

  /// -- Wholesale welcome & info video --------------------------------
  /// Shown once, in-app, the first time an APPROVED wholesaler logs in -- see
  /// `User.wholesaleWelcomeSeenAt`, which is the per-user flag that gates it.
  /// Null falls back to a sensible default rendered by the client, so an
  /// admin who never touches this field still gets a working message.
  wholesaleWelcomeMessage String?
  /// Optional video for the /mayoristas explainer page specifically -- NOT
  /// the homepage wholesale CTA band's background loop (`wholesaleVideoUrl`
  /// above). Deliberately its own column: the homepage band is a background
  /// loop behind a CTA, this is inline content on an informational page, and
  /// conflating them would mean one upload could never serve both roles well.
  wholesaleInfoVideoUrl   String?
  /// Same reasoning as `videoSectionPosX/Y` -- the /mayoristas video
  /// renders at a constant `aspect-video`, so one point covers every
  /// viewport.
  wholesaleInfoVideoPosX  Int     @default(50)
  wholesaleInfoVideoPosY  Int     @default(50)

  /// At or below how many units of ONE COLOUR the product page starts nudging
  /// ("¡Últimas 2 unidades disponibles!").
  ///
  /// Admin-configurable rather than hardcoded because the right number is a
  /// merchandising judgement, not an engineering one: it depends on how fast
  /// the client can restock a piece. Above the threshold no count is shown at
  /// all -- exact stock numbers were deliberately hidden from the storefront,
  /// and this is the one narrow exception where scarcity is the message.
  ///
  /// Per COLOUR, not per product: stock lives per colour (see the colour model
  /// in AGENTS.md), and "últimas 2" has to mean the colour the shopper is
  /// actually looking at.
  lowStockThreshold       Int     @default(3)

  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id          String        @id @default(cuid())
  type        HeroSlideType @default(IMAGE)
  desktopUrl  String
  mobileUrl   String?
  posterUrl   String?
  title       String?
  subtitle    String?
  ctaText     String?
  ctaHref     String?
  order       Int           @default(0)
  active      Boolean       @default(true)
  /// Focal point (CSS object-position) as whole percentages, 0-100, stored per
  /// breakpoint because the same media almost never crops well on both: a
  /// 16:9 desktop frame and a 9:16 phone frame keep entirely different parts
  /// of the picture. 50/50 is dead centre, which is what `object-cover` does
  /// on its own — so every slide that existed before this is unchanged.
  ///
  /// Kept as four Ints rather than two "50% 50%" strings: the drag control
  /// does arithmetic on these, and a numeric column is clamped and validated
  /// at the edge instead of being parsed back out of a string on every read.
  desktopPosX Int           @default(50)
  desktopPosY Int           @default(50)
  mobilePosX  Int           @default(50)
  mobilePosY  Int           @default(50)
  createdAt   DateTime      @default(now())
}

enum HeroSlideType {
  IMAGE
  VIDEO
}

model ImageBandeja {
  id        String   @id @default(cuid())
  url       String
  filename  String
  assigned  Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())
}

model PromoPopup {
  id        String   @id @default("singleton")
  active    Boolean  @default(false)
  imageUrl  String?
  /// Single point -- the popup renders at a constant `aspect-[4/3]` card
  /// regardless of viewport, so there is only one frame shape to crop for.
  imagePosX Int      @default(50)
  imagePosY Int      @default(50)
  title     String?
  subtitle  String?
  ctaText   String?  @default("Ver oferta")
  ctaHref   String?
  showOnce  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// One row per counted request, for the sliding-window rate limiter in
/// `src/lib/rate-limit.ts`.
///
/// A table rather than Redis because this project has no Redis/KV configured
/// and adding one for a shop this size would be infrastructure nobody
/// maintains. The cost is a row per request on the handful of guarded
/// endpoints, which `pruneRateLimitHits` trims opportunistically.
///
/// `key` is `<bucket>:<subject>` — e.g. `orders:ip:190.0.0.1` or
/// `admin-login:someone@example.com`. Deliberately opaque: the limiter does not
/// care what a subject is, which is what lets login count per EMAIL while the
/// public endpoints count per IP.
///
/// For admin login these rows double as the failed-attempt log (hence `ip`,
/// which is forensic rather than functional): a successful sign-in deletes the
/// key's rows, so a lockout resets on success without a second table.
///
/// RLS: enabled with NO policy — deny-all. Nothing but the server (Prisma, as
/// table owner) ever touches this, and letting anon read it would hand an
/// attacker the exact state of their own throttling.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  /// Best-effort, for reading the log after the fact. Null when no forwarding
  /// header was present.
  ip        String?
  createdAt DateTime @default(now())

  /// The limiter only ever asks "how many rows for this key since T", which is
  /// exactly this index, and the prune asks by createdAt alone.
  @@index([key, createdAt])
  @@index([createdAt])
}
