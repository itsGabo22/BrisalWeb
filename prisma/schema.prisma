generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  CLIENTE
  MAYORISTA
  ADMIN
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

/// Every review lands on PENDING and is invisible to shoppers until an admin
/// approves it. Brisal has no general customer login — only wholesale accounts —
/// so moderation, not authentication, is the spam gate.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Models ─────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  discounts   Discount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  comparePrice   Decimal?     @db.Decimal(10, 2)
  wholesalePrice Decimal?     @db.Decimal(10, 2)
  sku            String?      @unique
  stock          Int          @default(0)
  material       String?
  /// The PRIMARY colour, which belongs to the product itself — its own
  /// imageUrls, price, stock and sku ARE that colour's. ColorVariant rows are
  /// ADDITIONAL colours on top of it, so a single-colour product needs no
  /// variant and enters its stock only once.
  colorName      String?
  colorHex       String?
  imageUrls      String[]
  featured       Boolean      @default(false)
  active         Boolean      @default(true)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  tags           ProductTag[]
  discounts      Discount[]
  // A product with NO colorVariants is a simple product and keeps using
  // `imageUrls`, `price` and `stock` above exactly as before.
  colorVariants  ColorVariant[]
  reviews        Review[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// A shopper-submitted review. Anyone can write one without an account, which
/// is why `status` exists — nothing reaches the storefront unread.
model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Display name the shopper typed. Not a User link: reviewers are anonymous.
  authorName String
  /// 1-5. Validated at the API edge; there is no CHECK constraint because the
  /// only writer is the route, which clamps before it ever reaches Postgres.
  rating     Int
  title      String?
  body       String?
  /// Up to 4 customer photos, already processed to WebP and uploaded.
  imageUrls  String[]
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  /// The storefront always asks for one product's APPROVED reviews, and the
  /// rating aggregate groups by the same pair — so they share an index.
  @@index([productId, status])
  /// The moderation queue reads newest-first within a status.
  @@index([status, createdAt])
}

/// One colour of a product: its own images, its own stock, and optional
/// price overrides. A null `price`/`wholesalePrice` means "inherit the
/// product-level value" rather than "free" — see resolveVariantPricing.
model ColorVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName      String
  /// Hex for the swatch, shown in both the catalog filter and the selector.
  colorHex       String
  imageUrls      String[]
  price          Decimal? @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Discount {
  id         String        @id @default(cuid())
  code       String?       @unique
  label      String
  percentage Decimal       @db.Decimal(5, 2)
  scope      DiscountScope
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id])
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
}

model User {
  id           String    @id @default(cuid())
  authId       String    @unique
  email        String    @unique
  name         String?
  role         Role      @default(CLIENTE)
  businessName String?
  taxId        String?
  city         String?
  phone        String?
  approved     Boolean   @default(true) // set to false explicitly when a wholesale signup is pending review; not used for CLIENTE
  lastOrderAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  items           OrderItem[]
  total           Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING_WHATSAPP)
  customerName    String?
  customerPhone   String?
  wholesaleUserId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING_WHATSAPP
  CONFIRMED
  REJECTED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  imageUrl  String?
  /// Which colour was ordered. Null for simple products with no variants,
  /// so existing order history stays valid.
  color     String?
  /// The ColorVariant this line was ordered in, or null when the line is the
  /// product's PRIMARY colour (or the product has no colours at all). Stock
  /// lives per colour, so confirming an order can only decrement the right
  /// row if it knows which one it was. Deliberately NOT a relation: deleting a
  /// variant must not cascade into — or be blocked by — order history, which
  /// keeps its own `color` and `reference` snapshot regardless.
  colorVariantId String?
  /// The reference as it stood WHEN ORDERED. Stored rather than derived so a
  /// later SKU change can't rewrite what an old order says was shipped.
  reference String?
  /// How many of `quantity` were beyond the colour's available stock at order
  /// time — 0 when the line was fully in stock. This is the record of what the
  /// client still owes the customer ("sobrepedido"), and it is never rewritten
  /// when stock is later replenished: it says what was true when ordered.
  backorderQty Int @default(0)
}

model SiteConfig {
  id                 String   @id @default("singleton")
  announcementText   String   @default("Envíos gratis en compras superiores a $200.000")
  announcementActive Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model HeroSlide {
  id         String        @id @default(cuid())
  type       HeroSlideType @default(IMAGE)
  desktopUrl String
  mobileUrl  String?
  posterUrl  String?
  title      String?
  subtitle   String?
  ctaText    String?
  ctaHref    String?
  order      Int           @default(0)
  active     Boolean       @default(true)
  /// Focal point (CSS object-position) as whole percentages, 0-100, stored per
  /// breakpoint because the same media almost never crops well on both: a
  /// 16:9 desktop frame and a 9:16 phone frame keep entirely different parts
  /// of the picture. 50/50 is dead centre, which is what `object-cover` does
  /// on its own — so every slide that existed before this is unchanged.
  ///
  /// Kept as four Ints rather than two "50% 50%" strings: the drag control
  /// does arithmetic on these, and a numeric column is clamped and validated
  /// at the edge instead of being parsed back out of a string on every read.
  desktopPosX Int          @default(50)
  desktopPosY Int          @default(50)
  mobilePosX  Int          @default(50)
  mobilePosY  Int          @default(50)
  createdAt  DateTime      @default(now())
}

enum HeroSlideType {
  IMAGE
  VIDEO
}

model ImageBandeja {
  id        String   @id @default(cuid())
  url       String
  filename  String
  assigned  Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())
}

model PromoPopup {
  id        String   @id @default("singleton")
  active    Boolean  @default(false)
  imageUrl  String?
  title     String?
  subtitle  String?
  ctaText   String?  @default("Ver oferta")
  ctaHref   String?
  showOnce  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
